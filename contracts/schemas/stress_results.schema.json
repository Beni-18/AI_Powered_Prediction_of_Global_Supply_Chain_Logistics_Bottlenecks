{
  "name": "stress_results",
  "version": "1.0",
  "description": "One row per (scenario, stage, metric). Written by Stage05_GenAI/04_evaluation_engineer.py to Stage05_GenAI/reports/eval_stress_results.csv. Feeds the 20-scenario robustness matrix.",
  "primary_key": ["scenario_id", "stage", "metric", "generator"],
  "min_rows": 1,
  "columns": [
    {"name": "scenario_id", "dtype": "string", "pattern": "S[0-9]{2}|WILDCARD"},
    {"name": "stage", "dtype": "string", "allowed": ["ML", "DL", "NLP", "SLM"]},
    {"name": "metric", "dtype": "string", "allowed": ["detection_rate", "lead_time_h", "false_alarms_per_week", "f1", "faithfulness", "latency_ms"]},
    {"name": "value", "dtype": "float"},
    {"name": "n", "dtype": "int", "min": 1},
    {"name": "ci_lo", "dtype": "float", "nullable": true, "required": false},
    {"name": "ci_hi", "dtype": "float", "nullable": true, "required": false},
    {"name": "baseline_value", "dtype": "float", "nullable": true, "required": false, "note": "Same metric for the nominal (no-disruption) run, so degradation = baseline_value - value."},
    {"name": "generator", "dtype": "string", "allowed": ["CVAE", "GAN", "DIFFUSION", "SIMULATOR", "REAL_REPLAY"]}
  ]
}
