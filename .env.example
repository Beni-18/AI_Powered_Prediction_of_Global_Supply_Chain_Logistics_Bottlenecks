# Copy this file to ".env" on YOUR device and fill in what you need. ".env" is git-ignored. Never commit real keys.

# Optional: only if the team decides to let a hosted LLM draft scenario narratives or teacher summaries.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: Hugging Face token (only needed for gated models; the models we plan to use are public).
HF_TOKEN=

# Force offline mode when you test the Stage 4 offline demo (the offline test sets this itself too).
HF_HUB_OFFLINE=0

# Global switches
CASCADE_SEED=42
